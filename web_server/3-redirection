#!/usr/bin/env bash
# Configure a fresh Ubuntu machine: nginx with a 301 redirection on /redirect_me
export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y nginx
printf 'Holberton School for the win!\n' > /var/www/html/index.html
printf 'Holberton School for the win!\n' > /var/www/html/index.nginx-debian.html
cat > /etc/nginx/sites-available/default <<'EOF'
server {
	listen 80 default_server;
	listen [::]:80 default_server;

	root /var/www/html;

	index index.html index.nginx-debian.html;

	server_name _;

	location /redirect_me {
		return 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;
	}
}
EOF
service nginx restart || {
	service nginx stop > /dev/null 2>&1
	sleep 1
	rm -f /run/nginx.pid
	service nginx start
}
